<div class="page-bg">
  <div class="container py-5">

    <div class="card-lux">

      <!-- HEADER -->
      <div class="card-header-lux text-center">
        <h2>🗑️ Sản phẩm đã xóa</h2>
        <p>Danh sách sản phẩm trong thùng rác</p>

        <a href="/products/listProduct" class="btn-back">
          ← Quay lại sản phẩm
        </a>
      </div>

      <!-- BODY -->
      <div class="card-body-lux">

        {{#if products.length}}

        <div class="table-responsive">
          <table class="lux-table">
            <thead>
              <tr>
                <th>#</th>
                <th>Tên sản phẩm</th>
                <th>Giá</th>
                <th>Ngày xóa</th>
                <th>Hành động</th>
              </tr>
            </thead>

            <tbody>
              {{#each products}}
              <tr>
                <td>{{inc @index}}</td>
                <td class="product-name">{{this.name}}</td>
                <td>
                  <span class="price">{{this.price}} đ</span>
                </td>
                <td>{{this.deletedAt}}</td>
                <td>
                  <div class="btn-group-lux">
                    <button class="btn-lux btn-restore"
                            data-id="{{this._id}}"
                            data-action="restore">
                      Khôi phục
                    </button>

                    <button class="btn-lux btn-delete"
                            data-id="{{this._id}}"
                            data-action="forceDelete">
                      Xóa vĩnh viễn
                    </button>
                  </div>
                </td>
              </tr>
              {{/each}}
            </tbody>
          </table>
        </div>

        {{else}}

        <div class="empty-state">
          <h5>Thùng rác đang trống</h5>
          <p>Không có sản phẩm nào đã bị xóa</p>
        </div>

        {{/if}}

      </div>
    </div>
  </div>
</div>

<form name="action-form" method="POST"></form>

<script>
document.addEventListener('DOMContentLoaded', function () {

  document.querySelectorAll('.btn-lux').forEach(btn => {

    btn.addEventListener('click', async () => {

      const id = btn.dataset.id;
      const action = btn.dataset.action;

      if (!confirm('Bạn có chắc chắn?')) return;

      let url = '';
      let method = 'POST';

      if (action === 'restore') {
        url = `/products/${id}/restore?_method=PATCH`;
      }

      if (action === 'forceDelete') {
        url = `/products/${id}/force?_method=DELETE`;
      }

      try {
        const res = await fetch(url, { method });

        if (res.ok) {
          location.reload();
        } else {
          alert('Có lỗi xảy ra');
        }

      } catch (err) {
        alert('Server lỗi');
      }

    });

  });

});
</script>

