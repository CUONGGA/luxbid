<style>
  body {
    background: radial-gradient(circle at top right, #fdfdfd, #e0e0e0, #cfcfcf);
    font-family: 'Poppins', sans-serif;
    margin: 0;
    overflow-x: hidden;
  }

  .lux-header {
    text-align: center;
    margin-top: 50px;
    margin-bottom: 30px;
  }

  .lux-header h1 {
    font-family: 'Playfair Display', serif;
    font-size: 3rem;
    font-weight: 800;
    letter-spacing: 2px;
    text-transform: uppercase;
    background: linear-gradient(
      90deg,
      #bfa66b 0%,
      #fff9e6 35%,
      #bfa66b 70%,
      #a8862a 100%
    );
    background-size: 200%;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: lightSweep 8s ease-in-out infinite;
  }

  @keyframes lightSweep {
    0% { background-position: -100%; }
    50% { background-position: 100%; }
    100% { background-position: -100%; }
  }

  .product-container {
    background: rgba(255,255,255,0.05);
    backdrop-filter: blur(10px);
    border-radius: 25px;
    box-shadow: 0 15px 40px rgba(0,0,0,0.3);
    overflow: hidden;
    margin-bottom: 50px;
  }

  .product-image {
    width: 100%;
    height: 550px;
    object-fit: cover;
    display: block;
  }

  .product-body {
    padding: 2.5rem;
    text-align: center;
    color: #222;
  }

  .product-price {
    font-size: 2rem;
    font-weight: 700;
    color: #d4af37;
    margin-bottom: 20px;
    letter-spacing: 2px;
    text-shadow: 0 0 10px rgba(212,175,55,0.2);
  }

  .product-description {
    color: #444;
    font-size: 1.1rem;
    line-height: 1.6;
    max-width: 700px;
    margin: 0 auto 30px auto;
  }

  .action-buttons {
    display: flex;
    justify-content: center;
    gap: 20px;
    flex-wrap: wrap;
    margin-top: 20px;
  }

  .btn-lux {
    background: linear-gradient(135deg, #d4af37, #b8860b);
    color: white;
    border: none;
    font-weight: 600;
    border-radius: 40px;
    padding: 12px 35px;
    text-transform: uppercase;
    letter-spacing: 1px;
    box-shadow: 0 4px 15px rgba(212,175,55,0.3);
    transition: all 0.3s ease;
    text-decoration: none;
    cursor: pointer;
  }

  .btn-lux:hover {
    background: linear-gradient(135deg, #f5d76e, #d4af37);
    transform: translateY(-2px);
  }

  .btn-auction {
    background: linear-gradient(135deg, #111, #333);
    color: #fff;
  }

  .btn-auction:hover {
    background: linear-gradient(135deg, #d4af37, #b8860b);
  }

  .auction-form {
    margin-top: 30px;
    background: rgba(255,255,255,0.1);
    padding: 25px;
    border-radius: 20px;
    display: none;
    animation: fadeIn 0.3s ease-in-out;
  }

  .auction-form h3 {
    color: #d4af37;
    margin-bottom: 20px;
  }

  .form-group {
    margin-bottom: 15px;
  }

  .form-group input {
    width: 100%;
    padding: 10px 15px;
    border-radius: 10px;
    border: 1px solid #ccc;
    outline: none;
  }

  .btn-submit {
    background: linear-gradient(135deg, #d4af37, #b8860b);
    border: none;
    padding: 10px 25px;
    border-radius: 30px;
    color: white;
    cursor: pointer;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(-10px); }
    to { opacity: 1; transform: translateY(0); }
  }

  footer {
    text-align: center;
    padding: 30px;
    color: #777;
    font-size: 0.9rem;
  }
</style>


<div class="container text-center">

  <div class="lux-header">
    <h1>{{product.name}}</h1>
    <p class="text-muted">A timeless masterpiece of brilliance and perfection</p>
  </div>

  <div class="product-container mx-auto">
    <img src="{{product.image}}" alt="{{product.name}}" class="product-image" />

    <div class="product-body">

      <div class="product-price">
        {{product.price}}
      </div>

      <p class="product-description">
        {{product.description}}
      </p>

      <!-- ACTION BUTTONS -->
      <div class="action-buttons">
        <a href="/" class="btn-lux">⬅ Trở về</a>
        <button class="btn-lux btn-auction" onclick="toggleAuctionForm()">💰 Đấu giá</button>
      </div>

      <!-- AUCTION FORM -->
      <div id="auctionForm" class="auction-form">
        <h3>Đặt giá đấu</h3>

        <form action="/products/bid/{{product._id}}" method="POST">

          <div class="form-group">
            <input type="text" name="name" placeholder="Họ và tên" required>
          </div>
          <div class="form-group">
            <input type="text" name="phone" placeholder="Số điện thoại" required>
          </div>
          <div class="form-group">
            <input type="email" name="email" placeholder="Email" required>
          </div>

          <div class="form-group">
            <input type="number" name="bidPrice" placeholder="Giá bạn muốn đấu ($)" required>
          </div>

          <button type="submit" class="btn-submit">
            Gửi đấu giá
          </button>
        </form>
      </div>

    </div>
  </div>

</div>

<footer>
  © 2025 Diamond Gallery — Crafted by Perfection ✨
</footer>

<script>
  function toggleAuctionForm() {
    const form = document.getElementById('auctionForm');
    form.style.display = form.style.display === 'block' ? 'none' : 'block';
  }
</script>