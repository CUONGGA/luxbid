<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>LuxBid</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/bootstrap-icons.css">

    <style>
    /* ===== TOAST STYLE ===== */
    .lux-toast {
      position: fixed;
      top: 20px;
      left: 50%;
      transform: translateX(-50%) scale(0.95);
      background: #111;
      color: #fff;
      padding: 18px 30px;
      border-radius: 12px;
      border: 1px solid rgba(212,175,55,0.4);
      box-shadow: 0 20px 60px rgba(0,0,0,0.6);
      opacity: 0;
      animation: fadeScaleIn 0.4s ease forwards;
      z-index: 2000;
      font-size: 15px;
      text-align: center;
    }

    .lux-toast-content {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .lux-icon {
      color: #d4af37;
      font-size: 16px;
    }

    .lux-toast strong {
      color: #d4af37;
      font-weight: 600;
    }

    @keyframes fadeScaleIn {
      to {
        opacity: 1;
        transform: translateX(-50%) scale(1);
      }
    }

    /* ===== NAVBAR STYLE ===== */
    .navbar {
        background: #000;
        border-bottom: 1px solid rgba(255,255,255,0.08);
        position: sticky;
        top: 0;
        z-index: 1000;
        height: 56px;
    }

    .navbar-brand {
        font-size: 1.35rem;
        font-weight: 600;
        letter-spacing: 2px;
        color: #ffffff !important;
    }

    .navbar-brand span {
        color: #d4af37;
        font-weight: 700;
    }

    .nav-link {
        color: #cfcfcf !important;
        font-weight: 500;
        transition: 0.25s ease;
    }

    .nav-link:hover {
        color: #ffffff !important;
    }

    .dropdown-menu {
        background: #1a1a1a;
        border: 1px solid rgba(255,255,255,0.08);
        border-radius: 10px;
        padding: 6px;
        min-width: 220px;
    }

    .dropdown-item {
        color: #ddd;
        padding: 9px 14px;
        border-radius: 6px;
        font-size: 14px;
        transition: 0.2s ease;
    }

    .dropdown-item:hover {
        background: rgba(255,255,255,0.06);
        color: #fff;
    }

    .user-info {
        background: transparent;
        border: none;
        color: #fff;
        padding: 4px 8px;
    }

    .user-avatar {
        width: 34px;
        height: 34px;
        border-radius: 50%;
        margin-right: 8px;
        object-fit: cover;
        border: 1px solid rgba(255,255,255,0.2);
    }

    .user-name {
        font-size: 14px;
        font-weight: 500;
    }

    .btn-login-lux {
    position: relative;
    background: linear-gradient(135deg, #d4af37, #f5d76e);
    color: #000;
    border-radius: 30px;
    padding: 8px 22px;
    font-weight: 600;
    font-size: 14px;
    letter-spacing: 0.5px;
    border: 1px solid rgba(212,175,55,0.5);
    transition: all 0.3s ease;
    box-shadow: 0 4px 15px rgba(212,175,55,0.35);
    overflow: hidden;
    }

    .btn-login-lux:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 25px rgba(212,175,55,0.6);
    color: #000;
    }
    .btn-login-lux::before {
    content: "";
    position: absolute;
    top: 0;
    left: -75%;
    width: 50%;
    height: 100%;
    background: linear-gradient(
        120deg,
        rgba(255,255,255,0.1),
        rgba(255,255,255,0.6),
        rgba(255,255,255,0.1)
    );
    transform: skewX(-20deg);
    transition: 0.6s;
}

  .btn-login-lux:hover::before {
      left: 130%;
  }
    </style>
</head>

<body>

<!-- ===== TOAST LOGIN ===== -->
{{#if successLogin}}
<div class="lux-toast">
  <div class="lux-toast-content">
    <span class="lux-icon">✦</span>
    <span>
      Chào mừng 
      <strong>
        {{#if user.username}}
          {{user.username}}
        {{else}}
          {{user.name}}
        {{/if}}
      </strong>
      đến với LuxBid
    </span>
  </div>
</div>
{{/if}}

<!-- ===== TOAST REGISTER ===== -->
{{#if successRegister}}
<div class="lux-toast">
  <div class="lux-toast-content">
    <span class="lux-icon">✔</span>
    <span>
      Đăng ký tài khoản thành công!
      <strong>Vui lòng đăng nhập</strong>
    </span>
  </div>
</div>
{{/if}}

<!-- ===== TOAST BID SUCCESS ===== -->
{{#if bidSuccess}}
<div class="lux-toast">
  <div class="lux-toast-content">
    <span class="lux-icon">💎</span>
    <span>
      Đấu giá thành công!
      <strong>Chúng tôi sẽ sớm liên hệ bạn</strong>
    </span>
  </div>
</div>
{{/if}}

<!-- ===== NAVBAR ===== -->
{{#unless hideNavbar}}
<nav class="navbar navbar-expand-lg navbar-dark">
  <div class="container-fluid">

    <a class="navbar-brand text-uppercase" href="/">
      Lux<span>Bid</span>
    </a>

    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMenu">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="navbarMenu">
      <ul class="navbar-nav mb-2 mb-lg-0">
      {{#if user}}
        {{#if (eq user.role "admin")}}
          <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">
              Quản lý
            </a>
            <ul class="dropdown-menu">
              <li><a class="dropdown-item" href="/products/create">Thêm sản phẩm</a></li>
              <li><a class="dropdown-item" href="/products/listProduct">Sản phẩm của tôi</a></li>
            </ul>
          </li>
        {{/if}}
      {{/if}}
      </ul>

      {{#if user}}
        <div class="dropdown ms-auto">
          <button class="user-info d-flex align-items-center" data-bs-toggle="dropdown">
            <img src="/img/soicodoc.jpeg" class="user-avatar">
            <span class="user-name">
              {{#if user.username}}
                {{user.username}}
              {{else}}
                {{user.name}}
              {{/if}}
            </span>
          </button>

          <ul class="dropdown-menu dropdown-menu-end">
            <li><a class="dropdown-item" href="/products/listProduct">Sản phẩm của tôi</a></li>
            <li><hr class="dropdown-divider"></li>
            <li>
              <form action="/auth/logout" method="POST">
                <button type="submit" class="dropdown-item text-danger">
                  Đăng xuất
                </button>
              </form>
            </li>
          </ul>
        </div>
      {{else}}
        <a href="/auth/login" class="btn btn-login-lux ms-auto">
          Đăng nhập
        </a>
      {{/if}}

    </div>
  </div>
</nav>
{{/unless}}

{{{body}}}

<!-- ===== AUTO HIDE TOAST ===== -->
<script>
  setTimeout(() => {
    const toast = document.querySelector('.lux-toast');
    if (toast) {
      toast.style.transition = "all 0.4s ease";
      toast.style.opacity = "0";
      toast.style.transform = "translateY(-20px)";
      setTimeout(() => toast.remove(), 400);
    }
  }, 3500);
</script>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>